{
  "name": "hemnet-walkthrough-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/site-server.js",
    "dev": "node --env-file-if-exists=.env src/site-server.js --dev",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "format": "prettier --write \"src/**/*.js\" \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.js\" \"app/**/*.{ts,tsx,css}\" \"next.config.ts\" \"tsconfig.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.js\" \"app/**/*.{ts,tsx,css}\" \"next.config.ts\" \"tsconfig.json\"",
    "start:studio": "node --env-file-if-exists=.env src/server.js",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "noaks:serve": "node --env-file-if-exists=.env scripts/noaks-preview.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
