{
  "name": "hemnet-walkthrough-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "format": "prettier --write \"src/**/*.js\" \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.js\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
